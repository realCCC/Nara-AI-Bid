# Azure OpenAI (비워 두면 룰 추천만 동작 — RAG 순위·평가항목 추출은 룰/대체값으로 폴백)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
# 비우면 temperature를 넘기지 않음 (추론 모델 gpt-5.6-luna·gpt-6 계열은 기본값만 지원). 기본 0
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# LangSmith 추적 (선택): 그래프 노드·LLM 호출·검색/RAG 도구를 한 트레이스로 본다. https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-master-poc
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 기본값 있음
TENDERS_FILE=./data/raw/tenders_202605.json
COMPANIES_DIR=./data/companies
REGION_LIMITS_FILE=./data/region_limits.csv
PDF_DIR=./data/pdfs
# keyword(설치 불필요) | bge (uv sync --extra rag 필요) | azure (Azure OpenAI 임베딩 API, EMBEDDING_MODEL=배포 이름)
EMBEDDING_PROVIDER=keyword
EMBEDDING_MODEL=BAAI/bge-m3
# 추천 검색 상위 15건 재정렬 (EMBEDDING_PROVIDER=bge일 때만, 실패 시 생략)
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# S2 의미 점수: 업체별 키워드↔공고 코사인 백분위 (이하 0점 / 이상 1점)
SEM_LO_PCT=50
SEM_HI_PCT=97
# 1이면 RAG 청크 검색이 BM25 + BGE-M3 하이브리드 (상위 공고 청크만 임베딩해 pgvector에 저장, 미리 계산: scripts/warm_chunk_vectors.py)
CHUNK_EMBEDDING=1
# 청크 벡터 DB: docker compose up -d (연결 실패 시 청크 검색은 BM25만)
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/ai_master
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/app.db
SCORE_WEIGHTS=0.35,0.30,0.20,0.15
TOP_K=10
# 검증 서브에이전트가 재평가할 상위 건수 (LLM 키 필요, 3~5 권장)
VERIFY_TOP_N=10
# 검증(5단계)이 정답셋 기준 불통과면 비평 프롬프트로 공고서 근거 순위(4단계)를 다시 돌리는 최대 횟수 (0~2)
VERIFY_MAX_RETRY=2
# 1이면 RAG 단계에서 상위 10건 PDF를 나라장터에서 내려받음 (LLM 키가 있을 때만 의미 있음)
FETCH_PDFS=1
